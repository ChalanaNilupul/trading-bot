{
  "name": "trading-bot",
  "version": "3.0.0",
  "description": "Paper trading bot with shared backtest/live engine and account-level risk controls",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "bot": "node src/index.js",
    "backtest": "node src/backtester.js",
    "scan": "node src/scanner.js",
    "test": "node test/selftest.js && node --test test/*.test.js",
    "compare": "node src/compare.js",
    "api": "node --env-file=.env src/api.js",
    "tournament": "node --env-file=.env src/futuresTournament.js"
  }
}
