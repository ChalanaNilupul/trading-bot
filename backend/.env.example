# Export these variables in your process environment. Node 20.6+ can use --env-file.
# Never commit a real key. The dashboard API_KEY and AI provider keys are different.
AI_ENABLED=0
# Choose openai (default) or gemini. Only the selected provider key is required.
AI_PROVIDER=openai
GEMINI_API_KEY=
OPENAI_API_KEY=
# Set a model ID from the selected provider that supports structured outputs.
# For Gemini, use the bare model ID without the models/ prefix.
AI_MODEL=
AI_MIN_CONFIDENCE=0.75
AI_TIMEOUT_MS=8000
API_KEY=