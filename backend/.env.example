# Export these variables in your process environment. Node 20.6+ can use --env-file.
# Never commit a real key. The dashboard API_KEY and OpenAI key are different.
AI_ENABLED=0
OPENAI_API_KEY=
# Set a model available to your OpenAI project supporting structured outputs.
AI_MODEL=
AI_MIN_CONFIDENCE=0.75
AI_TIMEOUT_MS=8000
API_KEY=
