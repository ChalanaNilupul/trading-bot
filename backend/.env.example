# Export these variables in your process environment. Node 20.6+ can use --env-file.
# Never commit a real key. The dashboard API_KEY and AI provider keys are different.
AI_ENABLED=0
# Choose openai (default) or gemini. Only the selected provider key is required.
AI_PROVIDER=openai
GEMINI_API_KEY=
OPENAI_API_KEY=
# Set a model ID from the selected provider that supports structured outputs.
# For Gemini, use the bare model ID without the models/ prefix.
AI_MODEL=
AI_MIN_CONFIDENCE=0.75
AI_TIMEOUT_MS=8000
API_KEY=


# One coin overrides SYMBOLS. Use LONG or SHORT; SHORTS is superseded by DIRECTION.
BOT_SYMBOL=BTCUSDT
DIRECTION=LONG
STRATEGY=Breakout 50/20
# To keep multi-coin mode, remove BOT_SYMBOL.
SYMBOLS=BTCUSDT,ETHUSDT
INTERVAL=4h
START_BALANCE=1000
LEVERAGE=1
RISK_PERCENT=0.0025
MAX_MARGIN_PERCENT=0.10
PORTFOLIO_MAX_DAILY_LOSS_PCT=0.01
PORTFOLIO_MAX_DRAWDOWN_PCT=0.05
PORTFOLIO_MAX_OPEN_POSITIONS=1
PORTFOLIO_MAX_SAME_DIRECTION=1
PORTFOLIO_MAX_STOP_RISK_PCT=0.01
